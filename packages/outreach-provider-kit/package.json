{
  "name": "@splitin/outreach-provider-kit",
  "version": "0.0.0",
  "description": "Shared building blocks for outreach provider adapters: JSON HTTP with send-outcome classification, loopback OAuth (PKCE), delivery-status parsing.",
  "license": "MIT",
  "author": "SplitInTech",
  "homepage": "https://github.com/splitintech/outreach-engine/tree/main/packages/outreach-provider-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/splitintech/outreach-engine.git",
    "directory": "packages/outreach-provider-kit"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@splitin/outreach-contracts": "0.0.0"
  },
  "bugs": {
    "url": "https://github.com/splitintech/outreach-engine/issues"
  }
}
